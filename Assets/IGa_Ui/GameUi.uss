.creature-box {
    width: 18%;
    min-width: 160px;
    background-color: rgba(20, 20, 35, 0.75);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(120, 120, 200, 0.4);
    padding: 10px;
    margin: 6px;
    align-items: center;
    flex-direction: column;
}

.creature-label {
    font-size: 13px;
    color: rgb(200, 200, 255);
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.creature-viewport {
    width: 100%;
    height: 160px;
    background-color: rgba(5, 5, 15, 0.0);
    border-radius: 6px;
    margin-bottom: 8px;
}

.fitness-slider {
    width: 95%;
    margin-top: 6px;
}

.slider-value {
    font-size: 13px;
    color: rgb(160, 220, 160);
    margin-top: 3px;
}

.evolve-button {
    width: 260px;
    height: 48px;
    font-size: 15px;
    background-color: rgba(50, 90, 200, 0.9);
    color: white;
    border-radius: 10px;
    border-width: 0;
    -unity-font-style: bold;
    transition-duration: 0.12s;
}

.evolve-button:hover  { background-color: rgba(70, 120, 255, 1.0); }
.evolve-button:active { background-color: rgba(30, 60, 150, 1.0); }

.creature-viewport {
    background-color: rgba(0, 0, 0, 0); /* totalmente transparente */
    /* resto inalterado */
}
#Root {
    pointer-events: none; /* UI não consome o clique */
}

/* Mas sliders e botão precisam continuar recebendo input */
.fitness-slider, .evolve-button {
    pointer-events: auto;
}